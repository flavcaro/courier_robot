<?xml version="1.0"?>
<gui version="1.0">
  <camera name="user_camera">
    <!-- Bird's eye view: camera directly above the grid -->
    <!-- Position: X=2.5, Y=2.5 (center of 5x5 grid), Z=8.0 (high above) -->
    <pose>2.5 2.5 8.0 0 1.57 0</pose>
    
    <!-- Alternative poses (uncomment to use):
    
    1. Higher bird view (better for 5x5 grid):
    <pose>2.5 2.5 12.0 0 1.57 0</pose>
    
    2. Angled view (45° from above):
    <pose>2.5 -2.0 6.0 0 0.785 1.57</pose>
    
    3. Side view:
    <pose>2.5 -3.0 2.0 0 0 1.57</pose>
    
    -->
    
    <track>
      <min_dist>0.5</min_dist>
      <max_dist>50.0</max_dist>
    </track>
  </camera>
</gui>
