%% Courier Robot Behavior Tree - ACTUAL IMPLEMENTATION
%% Generated from controller.py
%% 
%% Node Types:
%% - Selector: ? (try children in order until one succeeds)
%% - Sequence: → (execute children in order, fail if any fails)
%% - Decorator: ↻ (modifies child behavior)
%% - Condition: ◇ (check/test)
%% - Action: ▢ (do something)

flowchart TD
    Root["Mission Root<br/>→(Sequence)"]
    
    %% Phase 0: Initial Planning
    PlanPath["Plan Path<br/>▢(BFS pathfinding)"]
    
    %% Phase 1: Navigate To Pickup
    NavPickupComplete["Nav To Pickup Complete<br/>↻(FailureIsSuccess)"]
    NavCell1["Navigate One Cell<br/>→(Sequence)"]
    Battery1["Battery Management<br/>?(Selector)"]
    CheckBatt1["Check Battery<br/>◇(Condition)"]
    ChargeBatt1["Charge Battery<br/>▢(Action)"]
    NavSeq1["Navigate<br/>→(Sequence)"]
    GetWaypoint1["Get Next Waypoint<br/>▢(Action)"]
    Rotate1["Rotate To Target<br/>▢(Action)"]
    MoveOrHandle1["Move Or Handle<br/>?(Selector)"]
    Move1["Move To Target<br/>▢(Action)"]
    HandleObs1["Handle Obstacle<br/>▢(Backup & Replan)"]
    Center1["Center On Cell<br/>▢(Action)"]
    
    %% Phase 2: Precise Pickup
    PickupSeq["Precise Pickup<br/>→(Sequence)"]
    AlignPickup["Align With AprilTag #4<br/>▢(Action)"]
    CollectObject["Collect Object<br/>▢(4s gripper animation)"]
    
    %% Phase 3: Plan Return
    PlanReturn["Plan Return Path<br/>▢(BFS pathfinding)"]
    
    %% Phase 3.5: Recenter After Pickup
    RecenterPickup["Recenter After Pickup<br/>▢(Action)"]
    
    %% Phase 4: Navigate Home
    NavHomeComplete["Nav To Home Complete<br/>↻(FailureIsSuccess)"]
    NavCell2["Navigate One Cell<br/>→(Sequence)"]
    Battery2["Battery Management<br/>?(Selector)"]
    CheckBatt2["Check Battery<br/>◇(Condition)"]
    ChargeBatt2["Charge Battery<br/>▢(Action)"]
    NavSeq2["Navigate<br/>→(Sequence)"]
    GetWaypoint2["Get Next Waypoint<br/>▢(Action)"]
    Rotate2["Rotate To Target<br/>▢(Action)"]
    MoveOrHandle2["Move Or Handle<br/>?(Selector)"]
    Move2["Move To Target<br/>▢(Action)"]
    HandleObs2["Handle Obstacle<br/>▢(Backup & Replan)"]
    Center2["Center On Cell<br/>▢(Action)"]
    
    %% Phase 5: Precise Delivery
    DeliverySeq["Precise Delivery<br/>→(Sequence)"]
    AlignHome["Align With AprilTag #0<br/>▢(Action)"]
    DeliverObject["Deliver Object<br/>▢(4s gripper animation)"]
    
    %% Main sequence connections
    Root --> PlanPath
    Root --> NavPickupComplete
    Root --> PickupSeq
    Root --> PlanReturn
    Root --> RecenterPickup
    Root --> NavHomeComplete
    Root --> DeliverySeq
    
    %% Navigate to Pickup structure
    NavPickupComplete --> NavCell1
    NavCell1 --> Battery1
    NavCell1 --> NavSeq1
    Battery1 --> CheckBatt1
    Battery1 --> ChargeBatt1
    NavSeq1 --> GetWaypoint1
    NavSeq1 --> Rotate1
    NavSeq1 --> MoveOrHandle1
    NavSeq1 --> Center1
    MoveOrHandle1 --> Move1
    MoveOrHandle1 --> HandleObs1
    
    %% Precise Pickup structure
    PickupSeq --> AlignPickup
    PickupSeq --> CollectObject
    
    %% Navigate to Home structure
    NavHomeComplete -->  NavCell2
    NavCell2 --> Battery2
    NavCell2 --> NavSeq2
    Battery2 --> CheckBatt2
    Battery2 --> ChargeBatt2
    NavSeq2 --> GetWaypoint2
    NavSeq2 --> Rotate2
    NavSeq2 --> MoveOrHandle2
    NavSeq2 --> Center2
    MoveOrHandle2 --> Move2
    MoveOrHandle2 --> HandleObs2
    
    %% Precise Delivery structure
    DeliverySeq --> AlignHome
    DeliverySeq --> DeliverObject
    
    %% Styling
    classDef selector fill:#FF9999,stroke:#CC0000,stroke-width:3px,color:#000
    classDef sequence fill:#99CCFF,stroke:#0066CC,stroke-width:3px,color:#000
    classDef decorator fill:#FFD699,stroke:#FF8C00,stroke-width:3px,color:#000
    classDef condition fill:#99DD99,stroke:#228B22,stroke-width:2px,color:#000
    classDef action fill:#CC99FF,stroke:#6600CC,stroke-width:2px,color:#000
    
    class Battery1,Battery2,MoveOrHandle1,MoveOrHandle2 selector
    class Root,NavCell1,NavCell2,NavSeq1,NavSeq2,PickupSeq,DeliverySeq sequence
    class NavPickupComplete,NavHomeComplete decorator
    class CheckBatt1,CheckBatt2 condition
    class PlanPath,GetWaypoint1,Rotate1,Move1,HandleObs1,Center1,AlignPickup,CollectObject,PlanReturn,RecenterPickup,GetWaypoint2,Rotate2,Move2,HandleObs2,Center2,AlignHome,DeliverObject action
